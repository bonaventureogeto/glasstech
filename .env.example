# Copy to .env.local for local runs; set the same names in Vercel for deploys.

# Places API (New) key, server side only. With it, the site shows Google's live
# rating and count, and `npm run reviews` can refresh src/content/reviews.json.
# Without it, the site uses the rating and count saved in reviews.json.
GOOGLE_PLACES_API_KEY=

# Google Search Console's HTML tag verification: paste only the token (the
# content="..." value of the meta tag Search Console gives you). Leave empty
# to leave the tag out.
NEXT_PUBLIC_GSC_VERIFICATION=
